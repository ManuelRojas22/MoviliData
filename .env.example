# Copia este archivo como .env y completa los valores reales
SECRET_KEY=genera-una-clave-aqui
DEBUG=False

DB_NAME=movilidata_os
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Hosts permitidos (separados por coma). Ejemplo para producción:
# ALLOWED_HOSTS=movilidata.tudominio.com,www.movilidata.tudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Obtén una key gratis en https://developer.tomtom.com
TOMTOM_API_KEY=
